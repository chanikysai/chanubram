datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  bio           String?
  password      String? // Added for credentials provider
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
