datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Goal {
  id          String    @id @default(cuid())
  title       String
  description String?
  targetDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  status      String    @default("active")
  progress    String?
}
