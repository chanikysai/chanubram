datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  bio           String?
  password      String? // Added for credentials provider
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Partner relationship
  partnerId String? @unique // ID of the user's partner, nullable. Made unique for one-to-one.
  Partner   User?   @relation("PartnerRelation", fields: [partnerId], references: [id])

  // Invites sent by this user
  SentInvites Invite[] @relation("InviterRelation")
}

model Invite {
  id        String   @id @default(uuid())
  code      String   @unique // The unique invite code
  expiresAt DateTime // When the invite code expires

  // User who sent the invite
  inviterId String
  Inviter   User     @relation("InviterRelation", fields: [inviterId], references: [id])

  createdAt DateTime @default(now())
}
