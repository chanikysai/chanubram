// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Assuming PostgreSQL, common for web apps. Can be changed if needed.
  url      = env("DATABASE_URL")
}

model Question {
  id        String   @id @default(cuid())
  text      String   @unique
  createdAt DateTime @default(now()) // Date this question was made available
  answers   Answer[]
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  userId     String   // Assuming user ID is available from auth
  text       String
  createdAt  DateTime @default(now())
}
